# Secrets and config - mount at runtime, never bake into image
panel/config/metadata-instances.json
panel/config/*.yaml
panel/config/*.yml
panel/.env
panel/.env.*
knowledge/.env
knowledge/.env.*

# Documentation - not needed at runtime
panel/docs/
knowledge/docs/

# Tests - not needed at runtime
panel/tests/
panel/e2e-*.sh
knowledge/__tests__/
knowledge/bin/e2e-*.sh

# Dependencies and build artifacts
**/node_modules
**/dist
**/build
**/.git
**/logs
**/*.log
**/data/
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite

# Editor/OS junk
**/.DS_Store
**/.idea/
**/.vscode/
**/*.swp
**/*.swo
